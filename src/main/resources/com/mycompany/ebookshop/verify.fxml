<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ebookshop.controller.VerifyController" style="-fx-background-color: #f5f8fc;">
  <children>
    <VBox spacing="12" maxWidth="460" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #dbe5ef; -fx-padding: 24; -fx-effect: dropshadow(three-pass-box, rgba(24,59,86,0.10), 18, 0, 0, 6);">
      <padding>
        <Insets top="24" right="24" bottom="24" left="24" />
      </padding>
      <children>
        <Label text="Email Verification" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #183b56;" />
        <Label text="Enter the verification token sent to your email address." wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #65758a;" />
        <Label text="Verification token" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #183b56;" />
        <TextField fx:id="tokenField" promptText="Token" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #dbe5ef; -fx-padding: 10 12;" />
        <Button text="Verify" fx:id="verifyButton" onAction="#handleVerify" style="-fx-background-color: #2d8cff; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-height: 40;" />
        <Label fx:id="messageLabel" visible="false" managed="false" wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #65758a;" />
      </children>
    </VBox>
  </children>
</StackPane>
