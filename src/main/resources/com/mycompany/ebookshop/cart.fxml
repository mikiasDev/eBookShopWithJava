<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.ebookshop.controller.CartController">
    
    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2c3e50; -fx-padding: 15 20;">
        <Label text="🛒 Shopping Cart" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Continue Shopping" onAction="#handleContinueShopping" 
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;"/>
    </HBox>
    
    <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTitle" text="Book Title" prefWidth="300"/>
            <TableColumn fx:id="colAuthor" text="Author" prefWidth="200"/>
            <TableColumn fx:id="colPrice" text="Price" prefWidth="100"/>
            <TableColumn fx:id="colQuantity" text="Quantity" prefWidth="100"/>
            <TableColumn fx:id="colTotal" text="Total" prefWidth="120"/>
        </columns>
    </TableView>
    
    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 15;">
        <Button text="Remove Selected" onAction="#handleRemoveItem"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Button text="Clear Cart" onAction="#handleClearCart"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox spacing="5" alignment="CENTER_RIGHT">
            <Label text="Subtotal: "><graphic><Label fx:id="subtotalLabel" style="-fx-font-weight: bold;"/></graphic></Label>
            <Label text="Tax (8%): "><graphic><Label fx:id="taxLabel" style="-fx-font-weight: bold;"/></graphic></Label>
            <Label text="Total: " style="-fx-font-size: 18px; -fx-font-weight: bold;">
                <graphic><Label fx:id="totalLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/></graphic>
            </Label>
        </VBox>
        <Button fx:id="checkoutButton" text="Proceed to Checkout" onAction="#handleCheckout"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10 30; -fx-cursor: hand;"/>
    </HBox>
</VBox>