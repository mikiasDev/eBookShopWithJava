<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.Line?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.ebookshop.controller.AdminController"
            prefHeight="760.0" prefWidth="1280.0"
            style="-fx-background-color: linear-gradient(to bottom right, #eaf3ff, #f8fbff);"
            stylesheets="@css/style.css">
    <children>
        <BorderPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <left>
                <VBox prefWidth="220.0" styleClass="admin-sidebar" BorderPane.alignment="CENTER">
                    <children>
                        <VBox alignment="CENTER" spacing="12.0" styleClass="sidebar-title-container" prefHeight="170.0">
                            <children>
                                <ImageView fitHeight="64.0" fitWidth="64.0" preserveRatio="true">
                                    <image><Image url="@images/uog_logo.jpg" /></image>
                                </ImageView>
                                <Label text="eBookShop" textFill="WHITE">
                                    <font><Font name="System Bold" size="24.0" /></font>
                                </Label>
                                <Label text="Admin Control Center" textFill="#d4e6f1">
                                    <font><Font size="12.0" /></font>
                                </Label>
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" prefHeight="80.0" spacing="5.0">
                            <children>
                                <Label text="Welcome, Admin" textFill="WHITE">
                                    <font><Font name="System" size="14.0" /></font>
                                </Label>
                                <Line endX="180.0" stroke="WHITE" strokeWidth="0.5" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0" VBox.vgrow="ALWAYS" style="-fx-padding: 18 0;">
                            <children>
                                <Button fx:id="dashboardBtn" id="dashboardBtn" onAction="#switchForm" maxWidth="Infinity" text="Dashboard" styleClass="sidebar-button" />
                                <Button fx:id="menuBtn" id="menuBtn" onAction="#switchForm" maxWidth="Infinity" text="Menu" styleClass="sidebar-button" />
                                <Button fx:id="inventoryBtn" id="inventoryBtn" onAction="#switchForm" maxWidth="Infinity" text="Inventory" styleClass="sidebar-button" />
                                <Button fx:id="customersBtn" id="customersBtn" onAction="#switchForm" maxWidth="Infinity" text="Customers" styleClass="sidebar-button-active" />
                            </children>
                        </VBox>

                        <VBox spacing="10.0" style="-fx-padding: 0 18 18 18;">
                            <children>
                                <Button onAction="#handleLogout" text="Logout" maxWidth="Infinity" styleClass="signout-button" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </left>
            <center>
                <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <content>
                        <VBox spacing="18.0" style="-fx-padding: 28;">
                            <children>
                                <VBox styleClass="page-header">
                                    <children>
                                        <Label text="Customers" styleClass="page-title" />
                                        <Label text="Registered users and account records" styleClass="page-subtitle" />
                                    </children>
                                </VBox>

                                <VBox spacing="14.0" styleClass="surface-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <Label text="Customer Database" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #183b56;" />
                                                <Label text="Search and manage registered accounts" style="-fx-text-fill: #6b7c93;" />
                                            </children>
                                        </HBox>
                                        <TableView fx:id="customerTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 18; -fx-background-color: white;">
                                            <columns>
                                                <TableColumn fx:id="colCustId" text="ID" prefWidth="90" />
                                                <TableColumn fx:id="colCustName" text="Customer Name" prefWidth="320" />
                                                <TableColumn fx:id="colCustEmail" text="Email" prefWidth="420" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
