<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mycompany.ebookshop.controller.ForgotPasswordController"
           styleClass="auth-page" stylesheets="@css/style.css">
    <children>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" pannable="true" styleClass="auth-scroll" StackPane.alignment="CENTER">
            <content>
                <StackPane alignment="CENTER">
                    <VBox alignment="CENTER" maxWidth="560" prefWidth="560" spacing="24">
                        <padding>
                            <Insets top="40" right="0" bottom="40" left="0" />
                        </padding>
                        <VBox alignment="CENTER" spacing="10">
                            <ImageView fitHeight="84" preserveRatio="true">
                                <Image url="@images/uog_logo.jpg" />
                            </ImageView>
                            <Text text="eBookShop" style="-fx-fill: #143954; -fx-font-size: 36px; -fx-font-weight: bold;" />
                            <Text text="University of Gondar Book Store" style="-fx-fill: #5f7285; -fx-font-size: 14px;" />
                        </VBox>

                        <VBox spacing="18" maxWidth="460" prefWidth="460"
                              style="-fx-background-color: white; -fx-background-radius: 24; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(24,59,86,0.16), 24, 0, 0, 10); -fx-border-color: rgba(26,95,122,0.18); -fx-border-width: 1; -fx-border-radius: 24;">
                            <VBox spacing="8" alignment="CENTER_LEFT">
                                <Text text="Reset your password" style="-fx-fill: #143954; -fx-font-size: 28px; -fx-font-weight: bold;" />
                                <Text text="Send a reset token to your email, then use it to set a new password" style="-fx-fill: #6b7c93; -fx-font-size: 13px;" />
                            </VBox>

                            <VBox spacing="12">
                                <VBox spacing="6">
                                    <Label text="Email" style="-fx-text-fill: #2f3e4e; -fx-font-weight: bold;" />
                                    <TextField fx:id="emailField" promptText="Enter your email" styleClass="field-input" />
                                </VBox>
                                <Button fx:id="requestTokenButton" text="SEND RESET TOKEN" onAction="#handleRequestResetToken" maxWidth="Infinity"
                                        style="-fx-background-color: linear-gradient(to right, #1a5f7a, #247ba0); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-pref-height: 48; -fx-background-radius: 12; -fx-cursor: hand;" />

                                <VBox spacing="6">
                                    <Label text="Reset Token" style="-fx-text-fill: #2f3e4e; -fx-font-weight: bold;" />
                                    <TextField fx:id="tokenField" promptText="Paste the 6-digit code from email" styleClass="field-input" />
                                </VBox>
                                <VBox spacing="6">
                                    <Label text="New Password" style="-fx-text-fill: #2f3e4e; -fx-font-weight: bold;" />
                                    <PasswordField fx:id="newPasswordField" promptText="Create new password" styleClass="field-input" />
                                </VBox>
                                <VBox spacing="6">
                                    <Label text="Confirm Password" style="-fx-text-fill: #2f3e4e; -fx-font-weight: bold;" />
                                    <PasswordField fx:id="confirmPasswordField" promptText="Repeat new password" styleClass="field-input" />
                                </VBox>

                                <Label fx:id="errorLabel" text="" wrapText="true" style="-fx-text-fill: #c0392b; -fx-font-size: 13px;" />
                                <Label fx:id="successLabel" text="" wrapText="true" style="-fx-text-fill: #2e8b57; -fx-font-size: 13px;" />

                                <VBox spacing="10">
                                    <Button fx:id="resetButton" text="RESET PASSWORD" onAction="#handleResetPassword" maxWidth="Infinity"
                                            style="-fx-background-color: linear-gradient(to right, #1a5f7a, #247ba0); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-pref-height: 48; -fx-background-radius: 12; -fx-cursor: hand;" />
                                    <Button text="BACK TO LOGIN" onAction="#handleBackToLogin" maxWidth="Infinity"
                                            style="-fx-background-color: transparent; -fx-text-fill: #1a5f7a; -fx-cursor: hand; -fx-border-color: #1a5f7a; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10 16;" />
                                </VBox>
                            </VBox>
                        </VBox>
                    </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </children>
</StackPane>
