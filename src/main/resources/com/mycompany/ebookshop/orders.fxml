<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ebookshop.controller.OrdersController" prefWidth="1000.0" prefHeight="700.0" stylesheets="@css/style.css" style="-fx-background-color: #f5f8fc;">
    <children>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="16.0" style="-fx-padding: 16;">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16" />
                    </padding>
                    <children>
                        <VBox spacing="8.0" style="-fx-padding: 16; -fx-border-radius: 12; -fx-background-color: white; -fx-border-color: #dbe5ef; -fx-border-width: 1; -fx-background-radius: 12;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <Label text="My Orders" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #183b56;" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button text="Back" onAction="#handleBack" style="-fx-padding: 8 16; -fx-font-size: 12px; -fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" />
                                    </children>
                                </HBox>
                                <Label text="View all your purchased orders and the books available to open." wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #65758a;" />
                            </children>
                        </VBox>

                        <VBox style="-fx-padding: 16; -fx-border-radius: 12; -fx-background-color: white; -fx-border-color: #dbe5ef; -fx-border-width: 1; -fx-background-radius: 12;" VBox.vgrow="ALWAYS">
                            <children>
                                <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS" style="-fx-font-size: 12px; -fx-padding: 8;">
                                    <columns>
                                        <TableColumn fx:id="colOrderId" text="Order #" prefWidth="80" />
                                        <TableColumn fx:id="colOrderDate" text="Purchase Date" prefWidth="180" />
                                        <TableColumn fx:id="colOrderTotal" text="Total Amount" prefWidth="120" />
                                        <TableColumn fx:id="colOrderStatus" text="Status" prefWidth="100" />
                                        <TableColumn fx:id="colOrderAction" text="Actions" prefWidth="320" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
