<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.ebookshop.controller.MainController">
    
    <!-- Menu Bar -->
    <MenuBar>
        <Menu text="File">
            <MenuItem text="Refresh" onAction="#handleRefresh"/>
            <SeparatorMenuItem/>
            <MenuItem text="Logout" onAction="#handleLogout"/>
            <MenuItem text="Exit" onAction="#handleExit"/>
        </Menu>
        <Menu text="Shop">
            <MenuItem text="Browse Books" onAction="#handleRefresh"/>
            <MenuItem text="View Cart" onAction="#handleViewCart"/>
            <MenuItem text="Checkout" onAction="#handleCheckout"/>
        </Menu>
        <Menu text="Account">
            <MenuItem text="My Profile" onAction="#handleProfile"/>
            <MenuItem text="Order History" onAction="#handleOrderHistory"/>
            <SeparatorMenuItem/>
            <MenuItem text="Change Password" onAction="#handleChangePassword"/>
        </Menu>
        <Menu text="Help">
            <MenuItem text="About" onAction="#handleAbout"/>
            <MenuItem text="Group Members" onAction="#handleGroupMembers"/>
        </Menu>
    </MenuBar>
    
    <!-- Rest of your existing main.fxml content -->
    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2c3e50; -fx-padding: 15 20;">
        <Label text="📚 eBookShop" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="welcomeLabel" style="-fx-text-fill: white;"/>
        <HBox onMouseClicked="#handleViewCart" style="-fx-cursor: hand;">
            <Label text="🛒 " style="-fx-font-size: 18px;"/>
            <Label fx:id="cartCountLabel" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
        </HBox>
    </HBox>
    
    <!-- Rest of your existing content... -->
</VBox>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.ebookshop.controller.MainController">
    
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2c3e50; -fx-padding: 15 20;">
                <Label text="📚 eBookShop" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="welcomeLabel" style="-fx-text-fill: white;"/>
                <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
            </HBox>
            
            <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #ecf0f1; -fx-padding: 10 20;">
                <TextField fx:id="searchField" promptText="🔍 Search books..." HBox.hgrow="ALWAYS" 
                          style="-fx-pref-height: 35; -fx-padding: 0 15; -fx-background-radius: 20;"/>
                <ComboBox fx:id="categoryFilter" style="-fx-pref-width: 150; -fx-pref-height: 35;"/>
                <Button text="🔄 Refresh" onAction="#handleRefresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;"/>
                <HBox onMouseClicked="#handleViewCart" style="-fx-cursor: hand;">
                    <Label text="🛒 " style="-fx-font-size: 18px;"/>
                    <Label fx:id="cartCountLabel" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
                </HBox>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <TableView fx:id="bookTable" style="-fx-background-color: white;">
            <columns>
                <TableColumn fx:id="colTitle" text="Title" prefWidth="250"/>
                <TableColumn fx:id="colAuthor" text="Author" prefWidth="200"/>
                <TableColumn fx:id="colPrice" text="Price" prefWidth="100"/>
                <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
                <TableColumn fx:id="colCategory" text="Category" prefWidth="120"/>
            </columns>
            <placeholder>
                <Label text="No books available" style="-fx-padding: 20;"/>
            </placeholder>
        </TableView>
    </center>
    
    <bottom>
        <HBox alignment="CENTER" spacing="15" style="-fx-padding: 15; -fx-background-color: #ecf0f1;">
            <Button text="➕ Add to Cart" onAction="#handleAddToCart" 
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-cursor: hand;"/>
            <Button text="🛒 View Cart" onAction="#handleViewCart"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-cursor: hand;"/>
        </HBox>
    </bottom>
</BorderPane>