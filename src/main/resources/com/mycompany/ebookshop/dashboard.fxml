<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.Line?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.ebookshop.controller.AdminController"
            prefHeight="760.0" prefWidth="1280.0"
            style="-fx-background-color: linear-gradient(to bottom right, #eaf3ff, #f8fbff);"
            stylesheets="@css/style.css">
    <children>
        <BorderPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <left>
                <VBox prefWidth="220.0" styleClass="admin-sidebar" BorderPane.alignment="CENTER">
                    <children>
                        <VBox alignment="CENTER" spacing="12.0" styleClass="sidebar-title-container" prefHeight="170.0">
                            <children>
                                <ImageView fitHeight="64.0" fitWidth="64.0" preserveRatio="true">
                                    <image><Image url="@images/uog_logo.jpg" /></image>
                                </ImageView>
                                <Label text="eBookShop" textFill="WHITE">
                                    <font><Font name="System Bold" size="24.0" /></font>
                                </Label>
                                <Label text="Admin Control Center" textFill="#d4e6f1">
                                    <font><Font size="12.0" /></font>
                                </Label>
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" prefHeight="80.0" spacing="5.0">
                            <children>
                                <Label text="Welcome, Admin" textFill="WHITE">
                                    <font><Font name="System" size="14.0" /></font>
                                </Label>
                                <Line endX="180.0" stroke="WHITE" strokeWidth="0.5" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0" VBox.vgrow="ALWAYS" style="-fx-padding: 18 0;">
                            <children>
                                <Button fx:id="dashboardBtn" id="dashboardBtn" onAction="#switchForm" maxWidth="Infinity" text="Dashboard" styleClass="sidebar-button-active" />
                                <Button fx:id="menuBtn" id="menuBtn" onAction="#switchForm" maxWidth="Infinity" text="Menu" styleClass="sidebar-button" />
                                <Button fx:id="inventoryBtn" id="inventoryBtn" onAction="#switchForm" maxWidth="Infinity" text="Inventory" styleClass="sidebar-button" />
                                <Button fx:id="customersBtn" id="customersBtn" onAction="#switchForm" maxWidth="Infinity" text="Customers" styleClass="sidebar-button" />
                            </children>
                        </VBox>

                        <VBox spacing="10.0" style="-fx-padding: 0 18 18 18;">
                            <children>
                                <Button onAction="#handleLogout" text="Logout" maxWidth="Infinity" styleClass="signout-button" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </left>
            <center>
                <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <content>
                        <VBox spacing="18.0" style="-fx-padding: 28;">
                            <children>
                                <VBox styleClass="page-header">
                                    <children>
                                        <Label text="Dashboard" styleClass="page-title" />
                                        <Label text="Business overview and live reporting" styleClass="page-subtitle" />
                                    </children>
                                </VBox>

                                <FlowPane hgap="16.0" vgap="16.0" prefWrapLength="980.0" styleClass="content-wrap">
                                    <children>
                                        <VBox styleClass="card-1" spacing="6.0" alignment="CENTER_LEFT" style="-fx-padding: 20;" minWidth="220.0" prefWidth="230.0">
                                            <children>
                                                <Label text="Total Customers" textFill="WHITE" />
                                                <Label fx:id="dashboard_NC" text="0" textFill="WHITE">
                                                    <font><Font name="System Bold" size="30.0" /></font>
                                                </Label>
                                            </children>
                                        </VBox>
                                        <VBox styleClass="card-2" spacing="6.0" alignment="CENTER_LEFT" style="-fx-padding: 20;" minWidth="220.0" prefWidth="230.0">
                                            <children>
                                                <Label text="Today's Income" textFill="WHITE" />
                                                <Label fx:id="dashboard_TI" text="\$0.00" textFill="WHITE">
                                                    <font><Font name="System Bold" size="30.0" /></font>
                                                </Label>
                                            </children>
                                        </VBox>
                                        <VBox styleClass="card-3" spacing="6.0" alignment="CENTER_LEFT" style="-fx-padding: 20;" minWidth="220.0" prefWidth="230.0">
                                            <children>
                                                <Label text="Total Revenue" textFill="WHITE" />
                                                <Label fx:id="dashboard_TotalI" text="\$0.00" textFill="WHITE">
                                                    <font><Font name="System Bold" size="30.0" /></font>
                                                </Label>
                                            </children>
                                        </VBox>
                                        <VBox styleClass="card-4" spacing="6.0" alignment="CENTER_LEFT" style="-fx-padding: 20;" minWidth="220.0" prefWidth="230.0">
                                            <children>
                                                <Label text="Books Sold" textFill="WHITE" />
                                                <Label fx:id="dashboard_NSP" text="0" textFill="WHITE">
                                                    <font><Font name="System Bold" size="30.0" /></font>
                                                </Label>
                                            </children>
                                        </VBox>
                                    </children>
                                </FlowPane>

                                <FlowPane hgap="16.0" vgap="16.0" prefWrapLength="980.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <VBox spacing="12.0" styleClass="surface-card" minWidth="320.0" prefWidth="460.0">
                                            <children>
                                                <Label text="Revenue Trend" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #183b56;" />
                                                <AreaChart fx:id="incomeChart" legendVisible="false" prefHeight="330.0">
                                                    <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                                                    <yAxis><NumberAxis side="LEFT" /></yAxis>
                                                </AreaChart>
                                            </children>
                                        </VBox>
                                        <VBox spacing="12.0" styleClass="surface-card" minWidth="320.0" prefWidth="460.0">
                                            <children>
                                                <Label text="Customer Growth" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #183b56;" />
                                                <BarChart fx:id="customerChart" legendVisible="false" prefHeight="330.0">
                                                    <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                                                    <yAxis><NumberAxis side="LEFT" /></yAxis>
                                                </BarChart>
                                            </children>
                                        </VBox>
                                    </children>
                                </FlowPane>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
