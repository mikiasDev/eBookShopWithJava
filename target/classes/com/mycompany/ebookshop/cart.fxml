<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.ebookshop.controller.CartController"
            prefHeight="760.0" prefWidth="1280.0"
            style="-fx-background-color: linear-gradient(to bottom right, #eef6ff, #fbfdff);"
            stylesheets="@css/style.css">
    <children>
        <VBox AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" spacing="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="82.0" spacing="20.0"
                      style="-fx-background-color: linear-gradient(to right, #183b56, #2d8cff); -fx-padding: 0 28; -fx-effect: dropshadow(three-pass-box, rgba(24,59,86,0.2), 12, 0, 0, 5);">
                    <children>
                        <VBox spacing="2.0">
                            <children>
                                <Label text="eBookShop" textFill="WHITE">
                                    <font><Font name="System Bold" size="24.0" /></font>
                                </Label>
                                <Label text="Shopping Cart" textFill="#dce8f7">
                                    <font><Font size="12.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleBack" text="Back to Catalog" style="-fx-background-color: rgba(255,255,255,0.16); -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 10 18; -fx-cursor: hand;" />
                    </children>
                </HBox>

                <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <content>
                        <VBox spacing="18.0" style="-fx-padding: 28;">
                            <children>
                                <VBox styleClass="page-header">
                                    <children>
                                        <Label text="My Cart" styleClass="page-title" />
                                        <Label text="Review items, adjust quantities, and continue to checkout" styleClass="page-subtitle" />
                                    </children>
                                </VBox>

                                <VBox spacing="14.0" styleClass="surface-card" VBox.vgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label text="Cart Items" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #183b56;" />
                                                <Label text="Editable quantities and live totals" style="-fx-text-fill: #6b7c93;" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 0 0 4 0;">
                                            <children>
                                                <Label text="Tip: select one or more rows, then choose selected checkout" style="-fx-text-fill: #2d8cff; -fx-font-size: 12px; -fx-font-style: italic;" />
                                            </children>
                                        </HBox>
                                        <TableView fx:id="cartTable" VBox.vgrow="ALWAYS" prefHeight="420.0" minHeight="320.0" style="-fx-background-radius: 18; -fx-background-color: white;">
                                            <columns>
                                                <TableColumn fx:id="colImage" text="" prefWidth="120" />
                                                <TableColumn fx:id="colTitle" text="Book Title" prefWidth="260" />
                                                <TableColumn fx:id="colAuthor" text="Author" prefWidth="180" />
                                                <TableColumn fx:id="colPrice" text="Price" prefWidth="140" />
                                                <TableColumn fx:id="colQuantity" text="Quantity" prefWidth="120" />
                                                <TableColumn fx:id="colTotal" text="Total" prefWidth="140" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>

                                <FlowPane hgap="16.0" vgap="16.0" prefWrapLength="1100.0" styleClass="content-wrap">
                                    <children>
                                        <VBox spacing="10.0" minWidth="300.0" prefWidth="420.0" styleClass="surface-card">
                                            <children>
                                                <Label text="Order Summary" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #183b56;" />
                                                <GridPane hgap="12.0" vgap="10.0">
                                                    <columnConstraints>
                                                        <ColumnConstraints minWidth="120.0" />
                                                        <ColumnConstraints hgrow="ALWAYS" />
                                                    </columnConstraints>
                                                    <children>
                                                        <Label text="Subtotal" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                                                        <Label fx:id="subtotalLabel" text="\$0.00" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #183b56;" />
                                                        <Label text="Tax" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                                                        <Label fx:id="taxLabel" text="\$0.00" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #183b56;" />
                                                        <Label text="Total" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                                                        <Label fx:id="totalLabel" text="\$0.00" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2d8cff;" />
                                                    </children>
                                                </GridPane>
                                            </children>
                                        </VBox>

                                        <VBox spacing="12.0" minWidth="300.0" prefWidth="420.0" styleClass="surface-card">
                                            <children>
                                                <Label text="Actions" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #183b56;" />
                                            <Button fx:id="checkoutButton" onAction="#handleCheckout" prefHeight="54.0" maxWidth="Infinity"
                                                style="-fx-background-color: #1fbf75; -fx-text-fill: white; -fx-background-radius: 14; -fx-font-weight: bold; -fx-font-size: 16; -fx-cursor: hand;" text="Pay All Items →" />
                                            <Button onAction="#handleCheckoutSelected" prefHeight="50.0" maxWidth="Infinity"
                                                style="-fx-background-color: linear-gradient(to right, #2d8cff, #5aa8ff); -fx-text-fill: white; -fx-background-radius: 14; -fx-font-weight: bold; -fx-font-size: 14; -fx-cursor: hand;"
                                                text="Pay Selected Items →" />
                                                <HBox spacing="10.0">
                                                    <children>
                                                        <Button onAction="#handleRemoveItem" text="Remove Item" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #eef4fb; -fx-text-fill: #183b56; -fx-background-radius: 12; -fx-cursor: hand;" />
                                                        <Button onAction="#handleClearCart" text="Clear Cart" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #fbeaea; -fx-text-fill: #c0392b; -fx-background-radius: 12; -fx-cursor: hand;" />
                                                    </children>
                                                </HBox>
                                                <Button onAction="#handleContinueShopping" text="Continue Shopping" maxWidth="Infinity"
                                                        style="-fx-background-color: transparent; -fx-text-fill: #2d8cff; -fx-border-color: #2d8cff; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-background-radius: 12; -fx-cursor: hand;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </FlowPane>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</AnchorPane>