                                            <children>
                                                <Label text="03" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d8cff;" />
                                                <Label text="Adane Worku" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #183b56;" />
                                                <Label text="ID: GUR/02251/15" style="-fx-font-size: 14px; -fx-text-fill: #51657a;" />
                                            </children>
                                        </VBox>

                                        <VBox style="-fx-background-color: #fbfdff; -fx-background-radius: 16; -fx-padding: 18; -fx-border-color: #dbe9f6; -fx-border-radius: 16;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <children>
                                                <Label text="04" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d8cff;" />
                                                <Label text="Bezawit Degu" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #183b56;" />
                                                <Label text="ID: GUR/02084/15" style="-fx-font-size: 14px; -fx-text-fill: #51657a;" />
                                            </children>
                                        </VBox>

                                        <VBox style="-fx-background-color: #fbfdff; -fx-background-radius: 16; -fx-padding: 18; -fx-border-color: #dbe9f6; -fx-border-radius: 16;" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                            <children>
                                                <Label text="05" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d8cff;" />
                                                <Label text="Eyobed Sisay" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #183b56;" />
                                                <Label text="ID: GUR/02343/15" style="-fx-font-size: 14px; -fx-text-fill: #51657a;" />
                                            </children>
                                        </VBox>

                                        <VBox style="-fx-background-color: #fbfdff; -fx-background-radius: 16; -fx-padding: 18; -fx-border-color: #dbe9f6; -fx-border-radius: 16;" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <children>
                                                <Label text="06" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d8cff;" />
                                                <Label text="Getaneh Degenie" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #183b56;" />
                                                <Label text="ID: GUR/02130/15" style="-fx-font-size: 14px; -fx-text-fill: #51657a;" />
                                            </children>
                                        </VBox>

