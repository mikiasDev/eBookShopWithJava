                        <HBox alignment="CENTER_RIGHT">
                            <children>
                                <Button onAction="#handleBackToMain" prefHeight="42.0" prefWidth="160.0"
                                        style="-fx-background-color: #2d8cff; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                                        text="Back to Store" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
