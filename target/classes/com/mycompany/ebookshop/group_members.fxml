<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.ebookshop.controller.GroupMembersController"
      style="-fx-background: linear-gradient(to bottom, #003399, #000066);">
    
    <MenuBar>
        <Menu text="Back">
            <MenuItem text="Back to Main" onAction="#handleBackToMain"/>
        </Menu>
    </MenuBar>
    
    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 30;">
            
            <!-- University Logo -->
            <VBox alignment="CENTER" spacing="10">
                <ImageView fitWidth="100" fitHeight="100" preserveRatio="true">
                    <Image url="@/com/mycompany/ebookshop/images/uog_logo.jpg" />
                </ImageView>
                <Label text="UNIVERSITY OF GONDAR" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="COLLEGE OF COMPUTING" style="-fx-font-size: 18px; -fx-text-fill: #CCCCCC;"/>
                <Label text="Department of Computer Science" style="-fx-font-size: 16px; -fx-text-fill: #CCCCCC;"/>
            </VBox>
            
            <!-- Project Info -->
            <VBox alignment="CENTER" spacing="5" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 15; -fx-padding: 20;">
                <Label text="📚 eBookShop" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #003399;"/>
                <Label text="Online Book Store System" style="-fx-font-size: 16px; -fx-text-fill: #666666;"/>
                <Label text="Academic Year: 2025/2026" style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
            </VBox>
            
            <!-- Group Members -->
            <VBox spacing="15" style="-fx-background-color: rgba(255,255,255,0.95); -fx-background-radius: 15; -fx-padding: 20;">
                <Label text="👥 GROUP MEMBERS" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #003399;"/>
                
                <GridPane hgap="20" vgap="15">
                    <!-- Member 1 -->
                    <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-padding: 10; -fx-border-color: #CCCCCC; -fx-border-radius: 10;">
                        <Label text="👨‍💻 Member 1" style="-fx-font-weight: bold; -fx-text-fill: #003399;"/>
                        <Label text="Name: Mikias Mulu" />
                        <Label text="ID: UGR/xxxxx/15" />
                        <Label text="Role: Project Lead & Backend" />
                    </VBox>
                    
                    <!-- Member 2 -->
                    <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-padding: 10; -fx-border-color: #CCCCCC; -fx-border-radius: 10;">
                        <Label text="👨‍💻 Member 2" style="-fx-font-weight: bold; -fx-text-fill: #003399;"/>
                        <Label text="Name: Adane Worku" />
                        <Label text="ID: UGR/xxxxx/15" />
                        <Label text="Role: Frontend & Database" />
                    </VBox>
                    
                    <!-- Add more members as needed -->
                    <VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-padding: 10; -fx-border-color: #CCCCCC; -fx-border-radius: 10;">
                        <Label text="👩‍💻 Member 3" style="-fx-font-weight: bold; -fx-text-fill: #003399;"/>
                        <Label text="Name: [Your Name]" />
                        <Label text="ID: UGR/xxxxx/15" />
                        <Label text="Role: UI/UX & Testing" />
                    </VBox>
                    
                    <VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-padding: 10; -fx-border-color: #CCCCCC; -fx-border-radius: 10;">
                        <Label text="👨‍💻 Member 4" style="-fx-font-weight: bold; -fx-text-fill: #003399;"/>
                        <Label text="Name: [Your Name]" />
                        <Label text="ID: UGR/xxxxx/15" />
                        <Label text="Role: Documentation & QA" />
                    </VBox>
                </GridPane>
            </VBox>
            
            <!-- Footer -->
            <Label text="© 2026 University of Gondar - Department of Computer Science" 
                   style="-fx-font-size: 11px; -fx-text-fill: #CCCCCC;"/>
        </VBox>
    </ScrollPane>
</VBox>