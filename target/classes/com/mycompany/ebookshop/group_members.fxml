                                            <children>
                                                <Label text="01" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d8cff;" />
                                                <Label text="Mikias Mulu" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #183b56;" />
                                                <Label text="ID: GUR/02007/15" style="-fx-font-size: 14px; -fx-text-fill: #51657a;" />
