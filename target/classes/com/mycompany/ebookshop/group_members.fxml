                                                <Label text="Abeje Ambaye-(added)" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #183b56;" />
                                                <Label text="ID: GUR/00129/17" style="-fx-font-size: 14px; -fx-text-fill: #51657a;" />
                                            </children>
                                        </VBox>
                                    </children>
