<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.ebookshop.controller.AdminController">
    
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2c3e50; -fx-padding: 15 20;">
            <Label text="👑 Admin Panel - eBookShop" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
        </HBox>
    </top>
    
    <center>
        <SplitPane dividerPositions="0.6" style="-fx-background-color: #ecf0f1;">
            <!-- Left: Book List -->
            <TableView fx:id="bookTable">
                <columns>
                    <TableColumn fx:id="colTitle" text="Title" prefWidth="200"/>
                    <TableColumn fx:id="colAuthor" text="Author" prefWidth="150"/>
                    <TableColumn fx:id="colPrice" text="Price" prefWidth="80"/>
                    <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
                    <TableColumn fx:id="colCategory" text="Category" prefWidth="100"/>
                </columns>
            </TableView>
            
            <!-- Right: Book Form -->
            <ScrollPane>
                <GridPane hgap="15" vgap="15" style="-fx-padding: 20;">
                    <Label text="Title:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="titleField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>
                    
                    <Label text="Author:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="authorField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    
                    <Label text="ISBN:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="isbnField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    
                    <Label text="Price:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="priceField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    
                    <Label text="Stock:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="stockField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    
                    <Label text="Category:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="categoryBox" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                    
                    <Label text="Description:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <TextArea fx:id="descriptionArea" GridPane.rowIndex="6" GridPane.columnIndex="1" prefHeight="100"/>
                    
                    <HBox spacing="10" GridPane.rowIndex="7" GridPane.columnIndex="1">
                        <Button text="Add Book" onAction="#handleAddBook" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;"/>
                        <Button text="Update" onAction="#handleUpdateBook" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;"/>
                        <Button text="Delete" onAction="#handleDeleteBook" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
                        <Button text="Clear" onAction="#handleClearForm" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand;"/>
                    </HBox>
                </GridPane>
            </ScrollPane>
        </SplitPane>
    </center>
</BorderPane>